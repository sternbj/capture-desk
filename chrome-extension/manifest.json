{
  "manifest_version": 3,
  "name": "Capture Desk",
  "version": "1.5.0",
  "description": "__MSG_description__",
  "minimum_chrome_version": "127",
  "icons": {
    "16": "icons/recorder-16.png",
    "32": "icons/recorder-32.png",
    "48": "icons/recorder-48.png",
    "128": "icons/recorder-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabCapture",
    "desktopCapture",
    "offscreen",
    "downloads",
    "clipboardWrite",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://openrouter.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Capture Desk",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/recorder-16.png",
      "24": "icons/recorder-24.png",
      "32": "icons/recorder-32.png",
      "48": "icons/recorder-48.png"
    }
  },
  "commands": {
    "pause-resume": {
      "global": true,
      "description": "__MSG_pause_resume__"
    },
    "stop-recording": {
      "global": true,
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "__MSG_stop_recording__"
    },
    "show-controls": {
      "global": true,
      "description": "__MSG_show_controls__"
    },
    "capture-visible": {
      "description": "__MSG_capture_visible__"
    },
    "capture-fullpage": {
      "description": "__MSG_capture_fullpage__"
    },
    "capture-region": {
      "description": "__MSG_capture_region__"
    },
    "start-recording": {
      "description": "__MSG_start_recording__"
    }
  },
  "default_locale": "en"
}
